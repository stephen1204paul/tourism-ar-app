# Application Configuration
NODE_ENV=development
APP_NAME=Tourism_AR_App
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/tourism_ar_db
MONGODB_URL=mongodb://admin:mongodb_password@localhost:27017/tourism_ar_content?authSource=admin
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d
REFRESH_TOKEN_EXPIRATION=30d

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id

# Storage Configuration (MinIO/S3)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET=tourism-ar-assets
STORAGE_USE_SSL=false

# AWS Configuration (Production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=tourism-ar-production

# Google Cloud Configuration (Alternative)
GCP_PROJECT_ID=your-gcp-project-id
GCP_STORAGE_BUCKET=tourism-ar-storage
GCP_KEY_FILE=./credentials/gcp-service-account.json

# Map Services
MAPBOX_ACCESS_TOKEN=your-mapbox-token
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
HERE_MAPS_APP_ID=your-here-maps-app-id
HERE_MAPS_APP_CODE=your-here-maps-app-code

# AR Configuration
AR_MARKER_SIZE=1.0
AR_TRACKING_RATE=60
AR_SMOOTH_THRESHOLD=5
AR_SMOOTH_TOLERANCE=0.01
AR_SMOOTH_COUNT=5

# Location Services
LOCATION_UPDATE_INTERVAL=5000
LOCATION_HIGH_ACCURACY=true
LOCATION_TIMEOUT=10000
LOCATION_MAX_AGE=0
GEOFENCE_RADIUS=100

# Content Delivery
CDN_URL=http://localhost:9000
CDN_CACHE_CONTROL=public, max-age=31536000
IMAGE_OPTIMIZATION=true
VIDEO_ADAPTIVE_STREAMING=true

# Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your-mixpanel-token
AMPLITUDE_API_KEY=your-amplitude-api-key
SENTRY_DSN=your-sentry-dsn

# Push Notifications
FCM_SERVER_KEY=your-fcm-server-key
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apns-team-id
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@tourism-ar-app.com

# Payment Processing (Optional)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:4000
SESSION_SECRET=your-session-secret-change-this
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=strict

# Monitoring
LOG_LEVEL=debug
LOG_FORMAT=json
MONITORING_ENABLED=true
APM_ENABLED=false

# Feature Flags
FEATURE_AR_NAVIGATION=true
FEATURE_SOCIAL_SHARING=true
FEATURE_OFFLINE_MODE=true
FEATURE_USER_CONTENT=false
FEATURE_PREMIUM_TOURS=false
FEATURE_LIVE_STREAMING=false

# Development Tools
DEBUG=tourism-ar:*
REACT_APP_DEBUG_AR=true
SHOW_3D_AXIS=true
SHOW_PERFORMANCE_MONITOR=true

# API Keys for External Services
WEATHER_API_KEY=your-weather-api-key
TRANSLATION_API_KEY=your-translation-api-key
PLACES_API_KEY=your-places-api-key
GEOCODING_API_KEY=your-geocoding-api-key

# Cache Configuration
CACHE_TTL=3600
CACHE_CHECK_PERIOD=600
CACHE_MAX_KEYS=1000
CACHE_MAX_SIZE=100mb

# Performance
MAX_3D_MODEL_SIZE=10485760
MAX_IMAGE_SIZE=5242880
MAX_VIDEO_SIZE=52428800
COMPRESSION_LEVEL=6
IMAGE_QUALITY=80

# Localization
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,it,ja,zh,ko,ar,pt
TIMEZONE=UTC
DATE_FORMAT=YYYY-MM-DD
TIME_FORMAT=HH:mm:ss